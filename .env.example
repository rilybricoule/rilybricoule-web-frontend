# Copiez ce fichier vers .env et remplissez vos vraies valeurs

# Google OAuth - Obtenir sur https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=

# Facebook OAuth - Obtenir sur https://developers.facebook.com/
VITE_FACEBOOK_APP_ID=

# Instagram OAuth - Obtenir sur https://developers.facebook.com/
VITE_INSTAGRAM_CLIENT_ID=



# App URL (frontend)
VITE_APP_URL=http://localhost:5173